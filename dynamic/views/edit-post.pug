extends layout 

block body 
  if post 
    .w3-card-4.w3-margin.w3-white
      .w3-container
        form.w3-panel(action=`/post/edit/${post.id}` method='post')
          h4
            label(for="postTitle") Title:
          h5
            input.w3-input.w3-margin-bottom(type="text"
                  name="postTitle"
                  placeholder=`post title`
                  value=postTitle || post.title)
          h4
            label(for="postTitle") Tags:
          h5
            input.w3-input.w3-margin-bottom(type="text"
                  name="postTags"
                  placeholder=`${post.tags}`
                  value=postTags)
          h4 
            label(for="postContent") Post body:
              textarea.w3-input.taTall(type="textarea" name="postContent" id="postContent" placeholder="your thoughts here...") #{postContent || post.content}
          button.w3-button.w3-padding-large.w3-black.w3-border.w3-margin-bottom SUBMIT CHANGES &raquo;
        .w3-container
          a(href="/home")
            button.w3-button.w3-padding-large.w3-white.w3-border.w3-margin-bottom CANCEL 

  else
    .w3-card-4.w3-margin.w3-white
      .w3-container
        h3
          b Sorry looks like this post doesn't exist...
      .w3-container
        p Check out our home page for any new posts or click one of the links to the right.